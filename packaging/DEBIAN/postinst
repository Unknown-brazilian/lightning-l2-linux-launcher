#!/bin/sh
set -e

# ANSI color only when stdout is an actual terminal - apt/dpkg always show
# postinst output, but it can also land in a log file or CI output where
# raw escape codes would just show up as garbage text.
if [ -t 1 ]; then
	YELLOW='\033[1;33m'
	RESET='\033[0m'
else
	YELLOW=''
	RESET=''
fi

printf "%b" "$YELLOW"
cat <<'BANNER'
 _    ___ ___ _  _ _____ _  _ ___ _  _  ___     _    ___
| |  |_ _/ __| || |_   _| \| |_ _| \| |/ __|___| |  |_  )
| |__ | | (_ | __ | | | | .` || || .` | (_ |___| |__ / /
|____|___\___|_||_| |_| |_|\_|___|_|\_|\___|   |____/___|
BANNER
printf "%b" "$RESET"
echo "        Bitcoin-only Lineage II: High Five"
echo

chmod +x /opt/lightning-l2/setup.sh /opt/lightning-l2/launch.sh
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
gtk-update-icon-cache /usr/share/icons/hicolor >/dev/null 2>&1 || true

echo "Lightning-L2 Linux Launcher installed - find 'Lightning-L2' in your applications menu."
exit 0
